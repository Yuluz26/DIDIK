# DIDIK Main Bersama as a systemd service, for a VPS without Docker (README.md, "Tanpa Docker").
#   sudo cp didik-live.service /etc/systemd/system/ && sudo systemctl enable --now didik-live
# Settings: /etc/didik/didik.env (from .env.example, plus the lines below). Caddy on the same machine
# sends https to 127.0.0.1:8080.

[Unit]
Description=DIDIK Main Bersama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=didik
Group=didik
WorkingDirectory=/opt/didik/live/server
EnvironmentFile=/etc/didik/didik.env
Environment=DIDIK_ENV=production
Environment=DIDIK_HOST=127.0.0.1
Environment=DIDIK_PORT=8080
Environment=DIDIK_DATA_DIR=/var/lib/didik
Environment=DIDIK_WEB_DIR=/opt/didik/live/web/build
ExecStart=/opt/didik/venv/bin/didik-live
Restart=always
RestartSec=3
# Open rooms are saved when the server stops.
TimeoutStopSec=30
KillSignal=SIGTERM
# every child's phone is one open socket
LimitNOFILE=65536

# Hardening: the service can only write its own data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/didik

[Install]
WantedBy=multi-user.target
