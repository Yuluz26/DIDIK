# DIDIK Main Bersama, pelayan sebenar. Salin ke .env dan isi. Jangan commit .env.

# --- Alamat laman -------------------------------------------------------------
# Nama domain yang menghala ke IP VPS ini (rekod A/AAAA) sebelum `docker compose up`.
DIDIK_DOMAIN=didik.contoh.my
# Alamat penuh laman: pautan bilik, kod QR dan pautan dalam emel dibina daripadanya.
DIDIK_PUBLIC_URL=https://didik.contoh.my
# Emel untuk Let's Encrypt (amaran sijil tamat tempoh).
ACME_EMAIL=admin@contoh.my

# --- Emel (set semula kata laluan) --------------------------------------------
# Kosong: pautan set semula ditulis dalam log pelayan (docker compose logs app).
DIDIK_SMTP_HOST=
DIDIK_SMTP_PORT=587
# starttls (587), ssl (465) atau none
DIDIK_SMTP_SECURITY=starttls
DIDIK_SMTP_USER=
DIDIK_SMTP_PASSWORD=
DIDIK_MAIL_FROM=DIDIK Main Bersama <no-reply@contoh.my>

# --- Pilihan ------------------------------------------------------------------
# Bot latihan untuk hos mencuba bilik seorang diri.
DIDIK_ALLOW_BOTS=0
# 1: tulis setiap permintaan (dengan alamat IP) dalam log. Lalai 0 demi privasi kanak-kanak.
DIDIK_ACCESS_LOG=0
# Bilangan sandaran yang disimpan (backup.sh).
DIDIK_BACKUP_KEEP=14
# PostgreSQL dan bukan SQLite (pilihan): postgresql+psycopg://pengguna:katalaluan@hos:5432/didik
DIDIK_DATABASE_URL=
